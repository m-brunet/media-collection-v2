{
    "name": "media-collection",
    "version": "0.1.0",
    "private": true,
    "description": "Media Collection: manage a shared household book library (Libris desktop, Leaf mobile)",
    "homepage": "https://github.com/m-brunet/media-collection-v2",
    "license": "MIT",
    "author": "Matthias Brunet",
    "repository": {
        "type": "git",
        "url": "https://github.com/m-brunet/media-collection-v2.git"
    },
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "type": "module",
    "main": "dist/apps/desktop/src/main.js",
    "scripts": {
        "postinstall": "install-electron",
        "dev": "node tools/dev.mjs",
        "start": "electron .",
        "build:runtime": "tsc -p tsconfig.runtime.json",
        "build:web": "vite build",
        "build": "npm run build:runtime && npm run build:web",
        "lint": "oxlint --deny-warnings",
        "lint:fix": "oxlint --fix && oxfmt .",
        "format": "oxfmt .",
        "format:check": "oxfmt --check .",
        "test:architecture": "vitest run tools/architecture",
        "test": "npm run build && vitest run",
        "test:unit": "vitest run apps/server/src apps/desktop/src apps/web/src --exclude **/*.e2e-spec.ts --exclude **/infrastructure/**",
        "test:api": "npm run build && vitest run apps/server/src tests/api --exclude **/*.spec.ts",
        "typecheck": "tsc --noEmit -p tsconfig.runtime.json && tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p tsconfig.tools.json && tsc --noEmit -p tsconfig.tests.json && tsc --noEmit -p apps/server/tsconfig.json",
        "check": "npm run build && npm run typecheck && npm run lint && npm run format:check && vitest run",
        "maintenance": "electron . --maintenance",
        "dev:reset-data": "npm run build:runtime && electron . --dev-reset-data",
        "dev:import-v1": "npm run build:runtime && electron . --dev-import-v1",
        "package": "npm run build && electron-builder",
        "package:dir": "npm run build && electron-builder --dir",
        "test:packaged": "node tools/packaged-smoke.mjs"
    },
    "dependencies": {
        "@nestjs/common": "^12.1.2",
        "@nestjs/core": "^12.1.2",
        "@nestjs/platform-express": "^12.1.2",
        "@xmcl/nat-api": "0.4.5",
        "acme-client": "5.4.0",
        "better-sqlite3": "^13.0.3",
        "cookie-parser": "^1.4.7",
        "electron-updater": "^6.8.11",
        "express": "^5.2.1",
        "fflate": "0.8.2",
        "helmet": "^8.3.0",
        "jose": "^6.2.12",
        "kysely": "^0.29.6",
        "qrcode": "1.5.4",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "sharp": "^0.35.5",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@fontsource/ibm-plex-mono": "^5.3.0",
        "@fontsource/inter": "^5.3.0",
        "@fontsource/space-grotesk": "^5.3.0",
        "@nestjs/testing": "^12.1.2",
        "@stylistic/eslint-plugin": "5.7.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/better-sqlite3": "^9.6.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/express": "^5.0.6",
        "@types/node": "^24.0.0",
        "@types/qrcode": "1.5.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "barcode-detector": "3.2.3",
        "electron": "^44.5.1",
        "electron-builder": "^26.15.3",
        "jsdom": "^30.1.3",
        "lucide-react": "^1.67.0",
        "oxc-resolver": "11.24.2",
        "oxfmt": "0.71.0",
        "oxlint": "1.86.0",
        "playwright": "^1.64.1",
        "react-router": "^8.5.1",
        "selfsigned": "^5.5.0",
        "typescript": "7.0.2",
        "vite": "^8.3.2",
        "vitest": "5.0.3",
        "zxing-wasm": "3.1.6"
    },
    "engines": {
        "node": ">=24"
    },
    "build": {
        "appId": "com.mediacollection.app",
        "productName": "Media Collection",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "apps/desktop/assets/**/*",
            "package.json"
        ],
        "asarUnpack": [
            "**/*.node",
            "**/node_modules/sharp/**/*",
            "**/node_modules/@img/**/*"
        ],
        "npmRebuild": false,
        "publish": [
            {
                "provider": "github",
                "owner": "m-brunet",
                "repo": "media-collection-v2",
                "releaseType": "draft"
            }
        ],
        "win": {
            "target": "nsis",
            "icon": "apps/desktop/assets/icons/libris.ico"
        },
        "nsis": {
            "oneClick": false,
            "perMachine": true,
            "allowElevation": true,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "Media Collection",
            "installerIcon": "apps/desktop/assets/icons/libris.ico",
            "uninstallerIcon": "apps/desktop/assets/icons/libris.ico",
            "include": "build/installer.nsh",
            "artifactName": "Media-Collection-Setup-${version}.${ext}",
            "deleteAppDataOnUninstall": false
        },
        "linux": {
            "target": "AppImage",
            "category": "Utility",
            "executableName": "media-collection",
            "icon": "apps/desktop/assets/icons/libris.png",
            "artifactName": "Media-Collection-${version}.${ext}"
        }
    }
}
